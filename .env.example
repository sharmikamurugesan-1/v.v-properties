# V.V Properties Environment Configuration
# Copy this file to .env.local for local development

# Official WhatsApp Contact (Digits only, including country code, e.g., 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint URL to receive validated leads (Google Apps Script, Zoho, Make, etc.)
LEAD_WEBHOOK_URL=

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID (e.g., 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# Canonical Production Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strict compliance check in check-content script (0 = lenient, 1 = strict fail on missing config)
STRICT_CONTENT=0
